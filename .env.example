# Browser: API base URL (same as jobfluencer4 REACT_APP_BACKEND_URL).
# Leave empty to call same-origin `/api/*` from Next.js.
# Or set to your API origin, e.g. http://localhost:8000 (CORS must allow the Next origin).
REACT_APP_BACKEND_URL=

# Server-only: when set, Next.js proxies `/api/*` to `${BACKEND_URL}/api/*`.
# Use this when the frontend uses empty REACT_APP_BACKEND_URL but your backend runs elsewhere.
# Example: BACKEND_URL=http://localhost:8000
BACKEND_URL=
